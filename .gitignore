# venv (uv-managed, 872M)
eon-fly-brain/.venv/

# large connectome data (re-downloadable; see HANDOFF.md repro commands)
eon-fly-brain/data/weight_csr.pkl
eon-fly-brain/data/*.parquet
eon-fly-brain/data/*.tsv
# VNC data (Path 2, once fetched)
eon-fly-brain/data/vnc_weight_csr.pkl
eon-fly-brain/data/vnc_io_index.npz
eon-fly-brain/data/manc/

# rebuildable result weight matrices (regenerated by fetch_manc.py; see HANDOFF.md repro commands)
eon-fly-brain/results/**/*weight_csr.pkl
eon-fly-brain/results/path2/reservoir_states.npz
eon-fly-brain/results/path2/outcomeD_ckpt_*

# python
__pycache__/
*.pyc

# macOS
.DS_Store

# third-party reference repos (276M, have their own .git; read-only, not ours)
fly_field_refs/

# large regenerable training datasets (rebuild: audit_t2_forward_readout.py, rung1_readout.py)
eon-fly-brain/results/**/*_dataset.npz
eon-fly-brain/results/**/*_bc_dataset.npz

# paper-writing working context (local drafting aid)
paper/project_context.md

# scratch renders and third-party literature PDFs (not ours to redistribute)
tmp/

# LaTeX build artifacts (rebuild with latexmk); run logs under results/ stay tracked
/*.aux
/*.fls
/*.fdb_latexmk
/*.log
eon-fly-brain/*.aux
eon-fly-brain/*.fls
eon-fly-brain/*.fdb_latexmk
eon-fly-brain/*.log
paper/**/*.aux
paper/**/*.fls
paper/**/*.fdb_latexmk
paper/**/*.log
paper/**/*.out
paper/**/*.blg

# regenerable LIF history cache (camera_ready_reruns.py; sha256 recorded in its report)
eon-fly-brain/results/path2/camera_ready/histories.npz
